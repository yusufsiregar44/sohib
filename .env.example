# Optional. `sohib setup` stores the same settings privately in your user data directory;
# environment variables override them. Never put tokens or passwords here: SohiB has none.
# Mode: browser (your signed-in Chrome), fixture (synthetic test data), or disabled.
STOCKBIT_MODE=browser
# Loopback CDP connection file written by `sohib setup` / `sohib connect`.
STOCKBIT_BROWSER_CONNECTION_FILE=
# Directory used for the browser profile and its lock file.
STOCKBIT_BROWSER_PROFILE=
# Isolated SohiB data directory (default: platform user data directory).
SOHIB_HOME=
# Chrome executable if it is not installed in a standard location.
SOHIB_CHROME_BINARY=
